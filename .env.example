# Copy this file to .env and fill values before running the app
# Either use DATABASE_URL (single connection string) OR the DB_* variables below
# Example DATABASE_URL (Postgres on Render): postgres://user:password@hostname:5432/dbname
# Example DATABASE_URL (MySQL): mysql://user:password@host:3306/database_name

# When deploying to Render, set the DATABASE_URL environment variable to the provided value.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: control SSL behavior (true/false). If not set and DATABASE_URL contains "render"
# the code will default to using ssl: { rejectUnauthorized: false } which matches Render.
# DB_SSL=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=hr_database
DB_USER=root
DB_PASSWORD=yourpassword

# JWT secret for signing tokens
JWT_SECRET=your_jwt_secret_here

# App port
PORT=3000
